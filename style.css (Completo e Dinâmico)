/* ============================================
   VARIÁVEIS GLOBAIS
============================================ */
:root {
    --preto: #0a0a0a;
    --preto-claro: #1a1a1a;
    --preto-card: #141414;
    --verde-pastel: #a8e6a3;
    --verde-pastel-escuro: #7bc776;
    --verde-pastel-suave: rgba(168, 230, 163, 0.1);
    --vermelho: #ff4d4d;
    --vermelho-escuro: #cc3333;
    --vermelho-suave: rgba(255, 77, 77, 0.1);
    --branco: #ffffff;
    --cinza-texto: #b8b8b8;
    --cinza-borda: #2a2a2a;

    --gradient-principal: linear-gradient(135deg, var(--verde-pastel) 0%, var(--vermelho) 100%);
    --gradient-escuro: linear-gradient(135deg, var(--preto) 0%, var(--preto-claro) 100%);

    --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.3);
    --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.4);
    --shadow-glow-green: 0 0 20px rgba(168, 230, 163, 0.4);
    --shadow-glow-red: 0 0 20px rgba(255, 77, 77, 0.4);

    --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-slow: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    --radius: 12px;
    --radius-lg: 20px;
}

/* ============================================
   RESET & BASE
============================================ */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: var(--preto);
    color: var(--branco);
    line-height: 1.6;
    overflow-x: hidden;
}

a { color: inherit; text-decoration: none; }
ul { list-style: none; }
img, svg { max-width: 100%; display: block; }

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 5%;
}

/* ============================================
   HEADER / NAVBAR
============================================ */
.header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(10, 10, 10, 0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--cinza-borda);
}

.navbar {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.9rem 5%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo-link {
    display: flex;
    align-items: center;
    gap: 12px;
    transition: var(--transition);
}

.logo-link:hover {
    transform: scale(1.03);
}

.logo-svg {
    width: 46px;
    height: 46px;
    transition: var(--transition);
    filter: drop-shadow(0 0 6px rgba(168, 230, 163, 0.3));
}

.logo-link:hover .logo-svg {
    filter: drop-shadow(0 0 14px rgba(168, 230, 163, 0.7));
}

.logo-text {
    font-size: 1.2rem;
    font-weight: 800;
    background: var(--gradient-principal);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: 0.5px;
}

.nav-links {
    display: flex;
    gap: 2rem;
    align-items: center;
}

.nav-links a {
    position: relative;
    font-weight: 500;
    padding: 6px 4px;
    transition: var(--transition);
    color: var(--cinza-texto);
}

.nav-links a:hover {
    color: var(--verde-pastel);
}

.nav-links a.active {
    color: var(--verde-pastel);
}

.nav-links a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 2px;
    background: var(--gradient-principal);
    border-radius: 2px;
    transition: width 0.3s ease;
}

.nav-links a:hover::after,
.nav-links a.active::after {
    width: 100%;
}

/* Menu toggle mobile */
.menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
}

.menu-toggle span {
    width: 26px;
    height: 3px;
    background: var(--verde-pastel);
    border-radius: 3px;
    transition: var(--transition);
}

.menu-toggle.active span:nth-child(1) {
    transform: rotate(45deg) translate(7px, 7px);
    background: var(--vermelho);
}
.menu-toggle.active span:nth-child(2) {
    opacity: 0;
}
.menu-toggle.active span:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -7px);
    background: var(--vermelho);
}

/* ============================================
   HERO
============================================ */
.hero {
    padding: 90px 5% 80px;
    background: radial-gradient(circle at 20% 30%, rgba(168, 230, 163, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 80% 70%, rgba(255, 77, 77, 0.08) 0%, transparent 50%),
                var(--preto);
    position: relative;
    overflow: hidden;
}

.hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
        linear-gradient(rgba(168, 230, 163, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(168, 230, 163, 0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
}

.hero-content {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    align-items: center;
    position: relative;
    z-index: 2;
}

.badge {
    display: inline-block;
    padding: 8px 18px;
    background: var(--verde-pastel-suave);
    border: 1px solid var(--verde-pastel);
    color: var(--verde-pastel);
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1.2rem;
    animation: pulseGlow 3s ease-in-out infinite;
}

@keyframes pulseGlow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(168, 230, 163, 0.4); }
    50% { box-shadow: 0 0 0 10px rgba(168, 230, 163, 0); }
}

.hero h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1.15;
    margin-bottom: 1.2rem;
    font-weight: 800;
}

.highlight-green {
    color: var(--verde-pastel);
    position: relative;
    display: inline-block;
    text-shadow: 0 0 30px rgba(168, 230, 163, 0.4);
}

.highlight-red {
    color: var(--vermelho);
    position: relative;
    display: inline-block;
    text-shadow: 0 0 30px rgba(255, 77, 77, 0.4);
}

.hero-text p {
    font-size: 1.1rem;
    color: var(--cinza-texto);
    margin-bottom: 2rem;
    max-width: 500px;
}

.hero-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
}

.hero-stats {
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
    border-top: 1px solid var(--cinza-borda);
}

.stat {
    display: flex;
    flex-direction: column;
}

.stat strong {
    font-size: 1.8rem;
    color: var(--verde-pastel);
    font-weight: 800;
    line-height: 1;
    margin-bottom: 4px;
}

.stat span {
    font-size: 0.85rem;
    color: var(--cinza-texto);
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* Code window */
.hero-visual {
    display: flex;
    justify-content: center;
}

.code-window {
    width: 100%;
    max-width: 420px;
    background: var(--preto-card);
    border: 1px solid var(--cinza-borda);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md), 0 0 40px rgba(168, 230, 163, 0.1);
    animation: floatY 5s ease-in-out infinite;
}

@keyframes floatY {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
}

.window-bar {
    display: flex;
    gap: 8px;
    padding: 14px;
    background: #0f0f0f;
    border-bottom: 1px solid var(--cinza-borda);
}

.dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
}
.dot.red { background: var(--vermelho); }
.dot.yellow { background: #ffcc33; }
.dot.green { background: var(--verde-pastel); }

.code-body {
    padding: 20px;
    font-family: 'Courier New', monospace;
    font-size: 0.9rem;
    line-height: 1.7;
    color: #d0d0d0;
    overflow-x: auto;
}

.c-green { color: var(--verde-pastel); }
.c-red { color: var(--vermelho); }

/* ============================================
   SEÇÕES
============================================ */
.section {
    padding: 80px 0;
}

.section-dark {
    background: var(--preto-claro);
    border-top: 1px solid var(--cinza-borda);
    border-bottom: 1px solid var(--cinza-borda);
}

.section-title {
    text-align: center;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 800;
    margin-bottom: 0.8rem;
}

.section-subtitle {
    text-align: center;
    color: var(--cinza-texto);
    margin-bottom: 3rem;
    font-size: 1.05rem;
}

/* ============================================
   CARDS GRID
============================================ */
.cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
}

.card {
    background: var(--preto-card);
    border: 1px solid var(--cinza-borda);
    border-radius: var(--radius);
    padding: 2rem 1.5rem;
    text-align: center;
    transition: var(--transition);
    position: relative;
    overflow: hidden;
}

.card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--gradient-principal);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
}

.card:hover {
    transform: translateY(-8px);
    border-color: var(--verde-pastel);
    box-shadow: var(--shadow-md), var(--shadow-glow-green);
}

.card:hover::before {
    transform: scaleX(1);
}

.card-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    display: inline-block;
    transition: var(--transition);
}

.card:hover .card-icon {
    transform: scale(1.15) rotate(-5deg);
}

.card h3 {
    color: var(--verde-pastel);
    margin-bottom: 0.7rem;
    font-size: 1.2rem;
}

.card p {
    color: var(--cinza-texto);
    font-size: 0.95rem;
}

/* ============================================
   BOTÕES
============================================ */
.btn {
    display: inline-block;
    padding: 13px 30px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    border: 2px solid transparent;
    transition: var(--transition);
    text-align: center;
    letter-spacing: 0.3px;
    font-family: inherit;
}

.btn-primary {
    background: var(--gradient-principal);
    color: var(--preto);
    box-shadow: 0 4px 15px rgba(168, 230, 163, 0.3);
}

.btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(168, 230, 163, 0.5);
}

.btn-outline {
    background: transparent;
    color: var(--verde-pastel);
    border-color: var(--verde-pastel);
}

.btn-outline:hover {
    background: var(--verde-pastel);
    color: var(--preto);
    transform: translateY(-3px);
    box-shadow: var(--shadow-glow-green);
}

.btn-full {
    width: 100%;
}

/* ============================================
   BUSINESS CARD
============================================ */
.business-card-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
}

.business-card {
    perspective: 1200px;
    width: 100%;
    max-width: 420px;
}

.bc-front {
    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%);
    border: 2px solid var(--verde-pastel);
    border-radius: var(--radius-lg);
    padding: 2rem 1.8rem;
    position: relative;
    overflow: hidden;
    transition: var(--transition);
    box-shadow: var(--shadow-md), 0 0 40px rgba(168, 230, 163, 0.15);
}

.bc-front::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(255, 77, 77, 0.08) 0%, transparent 60%);
    pointer-events: none;
}

.bc-front::after {
    content: '';
    position: absolute;
    bottom: -30px;
    right: -30px;
    width: 120px;
    height: 120px;
    background: var(--gradient-principal);
    border-radius: 50%;
    opacity: 0.15;
    filter: blur(20px);
}

.business-card:hover .bc-front {
    transform: rotateY(-5deg) rotateX(3deg) scale(1.03);
    box-shadow: var(--shadow-md), 0 0 60px rgba(168, 230, 163, 0.35);
}

.bc-logo {
    width: 70px;
    height: 70px;
    margin-bottom: 1rem;
}

.bc-logo svg {
    width: 100%;
    height: 100%;
}

.bc-front h3 {
    font-size: 1.6rem;
    color: var(--verde-pastel);
    margin-bottom: 0.3rem;
    font-weight: 800;
}

.bc-role {
    color: var(--vermelho);
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 1rem;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.bc-line {
    display: block;
    width: 60px;
    height: 2px;
    background: var(--gradient-principal);
    margin-bottom: 1.2rem;
    border-radius: 2px;
}

.bc-contact {
    color: var(--cinza-texto);
    font-size: 0.9rem;
    margin-bottom: 0.4rem;
}

.bc-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
}

/* ============================================
   PAGE HEADER
============================================ */
.page-header {
    padding: 80px 0 50px;
    text-align: center;
    background: radial-gradient(circle at 50% 50%, rgba(168, 230, 163, 0.08) 0%, transparent 70%), var(--preto);
    border-bottom: 1px solid var(--cinza-borda);
}

.page-header h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 0.8rem;
}

.page-header p {
    color: var(--cinza-texto);
    font-size: 1.1rem;
}

/* ============================================
   TIMELINE
============================================ */
.timeline {
    position: relative;
    padding-left: 40px;
    max-width: 800px;
    margin: 0 auto;
}

.timeline::before {
    content: '';
    position: absolute;
    left: 12px;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--gradient-principal);
    border-radius: 3px;
}

.timeline-item {
    position: relative;
    margin-bottom: 2.5rem;
    opacity: 0;
    transform: translateX(-40px);
    transition: var(--transition-slow);
}

.timeline-item.visible {
    opacity: 1;
    transform: translateX(0);
}

.timeline-dot {
    position: absolute;
    left: -34px;
    top: 8px;
    width: 16px;
    height: 16px;
    background: var(--verde-pastel);
    border: 3px solid var(--preto);
    border-radius: 50%;
    box-shadow: 0 0 0 3px var(--verde-pastel), 0 0 15px var(--verde-pastel);
    animation: pulseDot 2s ease-in-out infinite;
}

@keyframes pulseDot {
    0%, 100% { box-shadow: 0 0 0 3px var(--verde-pastel), 0 0 15px var(--verde-pastel); }
    50% { box-shadow: 0 0 0 6px rgba(168, 230, 163, 0.2), 0 0 25px var(--verde-pastel); }
}

.timeline-date {
    display: inline-block;
    background: var(--vermelho);
    color: var(--branco);
    padding: 5px 16px;
    border-radius: 20px;
    font-weight: 700;
    font-size: 0.85rem;
    margin-bottom: 10px;
    box-shadow: 0 4px 12px rgba(255, 77, 77, 0.3);
}

.timeline-content {
    background: var(--preto-card);
    border: 1px solid var(--cinza-borda);
    border-left: 3px solid var(--verde-pastel);
    border-radius: var(--radius);
    padding: 1.5rem;
    transition: var(--transition);
}

.timeline-content:hover {
    border-left-color: var(--vermelho);
    transform: translateX(6px);
    box-shadow: var(--shadow-md);
}

.timeline-content h3 {
    color: var(--verde-pastel);
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
}

.timeline-content p {
    color: var(--cinza-texto);
    font-size: 0.95rem;
}

/* ============================================
   SKILLS
============================================ */
.skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.8rem;
    max-width: 950px;
    margin: 0 auto;
}

.skill-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
    font-weight: 600;
    font-size: 0.95rem;
}

.skill-percent {
    color: var(--verde-pastel);
}

.skill-bar {
    height: 10px;
    background: var(--preto);
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--cinza-borda);
}

.skill-fill {
    height: 100%;
    width: 0;
    background: var(--gradient-principal);
    border-radius: 10px;
    transition: width 1.5s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 0 10px rgba(168, 230, 163, 0.5);
}

/* ============================================
   SERVICES
============================================ */
.services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.8rem;
}

.service-card {
    background: var(--preto-card);
    border: 1px solid var(--cinza-borda);
    border-radius: var(--radius-lg);
    padding: 2rem 1.8rem;
    transition: var(--transition);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

.service-card::before {
    content: '';
    position: absolute;
    top: -60%;
    right: -60%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(168, 230, 163, 0.08) 0%, transparent 50%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
}

.service-card:hover {
    transform: translateY(-10px);
    border-color: var(--verde-pastel);
    box-shadow: var(--shadow-md), var(--shadow-glow-green);
}

.service-card:hover::before {
    opacity: 1;
}

.service-icon {
    font-size: 2.8rem;
    margin-bottom: 1rem;
    transition: var(--transition);
    display: inline-block;
}

.service-card:hover .service-icon {
    transform: scale(1.15) rotate(-6deg);
}

.service-card h3 {
    color: var(--verde-pastel);
    margin-bottom: 0.8rem;
    font-size: 1.25rem;
}

.service-card > p {
    color: var(--cinza-texto);
    font-size: 0.95rem;
    margin-bottom: 1rem;
}

.service-list {
    margin-bottom: 1.5rem;
    flex-grow: 1;
}

.service-list li {
    color: var(--cinza-texto);
    font-size: 0.9rem;
    padding: 4px 0;
}

.service-list li {
    color: var(--verde-pastel);
}

.service-price {
    display: inline-block;
    align-self: flex-start;
    background: var(--vermelho-suave);
    color: var(--vermelho);
    border: 1px solid var(--vermelho);
    padding: 8px 18px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 0.9rem;
}

/* ============================================
   CTA
============================================ */
.cta {
    padding: 70px 5%;
    text-align: center;
    background: linear-gradient(135deg, rgba(168, 230, 163, 0.08) 0%, rgba(255, 77, 77, 0.08) 100%), var(--preto-claro);
    border-top: 1px solid var(--cinza-borda);
    border-bottom: 1px solid var(--cinza-borda);
}

.cta h2 {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    margin-bottom: 0.8rem;
    font-weight: 800;
}

.cta p {
    color: var(--cinza-texto);
    margin-bottom: 1.8rem;
    font-size: 1.05rem;
}

/* ============================================
   CONTACT
============================================ */
.contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3rem;
    align-items: start;
}

.contact-info h2 {
    font-size: 1.8rem;
    margin-bottom: 1rem;
    font-weight: 800;
}

.contact-info > p {
    color: var(--cinza-texto);
    margin-bottom: 2rem;
}

.info-item {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1.5rem;
    padding: 1rem;
    background: var(--preto-card);
    border: 1px solid var(--cinza-borda);
    border-radius: var(--radius);
    transition: var(--transition);
}

.info-item:hover {
    border-color: var(--verde-pastel);
    transform: translateX(6px);
    box-shadow: var(--shadow-sm);
}

.info-icon {
    font-size: 1.6rem;
    flex-shrink: 0;
}

.info-item h4 {
    color: var(--verde-pastel);
    font-size: 0.95rem;
    margin-bottom: 2px;
}

.info-item p {
    color: var(--cinza-texto);
    font-size: 0.9rem;
}

.social-links {
    display: flex;
    gap: 0.8rem;
    margin-top: 1.5rem;
}

.social-btn {
    width: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--preto-card);
    border: 1px solid var(--cinza-borda);
    border-radius: 50%;
    font-size: 1.2rem;
    transition: var(--transition);
}

.social-btn:hover {
    background: var(--verde-pastel);
    color: var(--preto);
    transform: translateY(-4px) rotate(8deg);
    box-shadow: var(--shadow-glow-green);
    border-color: var(--verde-pastel);
}

/* Form */
.contact-form-wrapper {
    background: var(--preto-card);
    border: 1px solid var(--cinza-borda);
    border-radius: var(--radius-lg);
    padding: 2rem;
}

.contact-form h2 {
    font-size: 1.6rem;
    margin-bottom: 1.5rem;
    font-weight: 800;
}

.form-group {
    margin-bottom: 1.2rem;
}

.form-group label {
    display: block;
    margin-bottom: 6px;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--cinza-texto);
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;
    padding: 12px 16px;
    background: var(--preto);
    border: 1px solid var(--cinza-borda);
    border-radius: 10px;
    color: var(--branco);
    font-size: 0.95rem;
    font-family: inherit;
    transition: var(--transition);
    resize: vertical;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    outline: none;
    border-color: var(--verde-pastel);
    box-shadow: 0 0 0 3px rgba(168, 230, 163, 0.15);
}

.form-group input::placeholder,
.form-group textarea::placeholder {
    color: #666;
}

.form-group.error input,
.form-group.error select,
.form-group.error textarea {
    border-color: var(--vermelho);
    box-shadow: 0 0 0 3px rgba(255, 77, 77, 0.15);
}

.error-msg {
    display: block;
    color: var(--vermelho);
    font-size: 0.8rem;
    margin-top: 4px;
    min-height: 16px;
}

.form-feedback {
    margin-top: 1rem;
    padding: 12px;
    border-radius: 10px;
    text-align: center;
    font-weight: 600;
    display: none;
    animation: slideIn 0.4s ease;
}

.form-feedback.success {
    display: block;
    background: var(--verde-pastel-suave);
    border: 1px solid var(--verde-pastel);
    color: var(--verde-pastel);
}

.form-feedback.error {
    display: block;
    background: var(--vermelho-suave);
    border: 1px solid var(--vermelho);
    color: var(--vermelho);
}

@keyframes slideIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
}

/* ============================================
   FOOTER
============================================ */
.footer {
    background: var(--preto-claro);
    border-top: 1px solid var(--cinza-borda);
    padding-top: 3rem;
}

.footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
    padding-bottom: 2rem;
}

.footer-col h4 {
    color: var(--verde-pastel);
    margin-bottom: 1rem;
    font-size: 1.1rem;
}

.footer-col p,
.footer-col li {
    color: var(--cinza-texto);
    font-size: 0.9rem;
    margin-bottom: 6px;
}

.footer-col ul li a {
    transition: var(--transition);
}

.footer-col ul li a:hover {
    color: var(--verde-pastel);
    padding-left: 6px;
}

.footer-bottom {
    border-top: 1px solid var(--cinza-borda);
    padding: 1.5rem 5%;
    text-align: center;
    color: var(--cinza-texto);
    font-size: 0.85rem;
}

/* ============================================
   RESPONSIVO
============================================ */
@media (max-width: 900px) {
    .hero-content {
        grid-template-columns: 1fr;
        text-align: center;
    }
    .hero-text p {
        margin-left: auto;
        margin-right: auto;
    }
    .hero-buttons {
        justify-content: center;
    }
    .hero-stats {
        justify-content: center;
    }
    .contact-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 700px) {
    .menu-toggle {
        display: flex;
    }

    .nav-links {
        position: fixed;
        top: 70px;
        right: -100%;
        width: 75%;
        max-width: 300px;
        height: calc(100vh - 70px);
        background: var(--preto-claro);
        flex-direction: column;
        align-items: flex-start;
        padding: 2rem;
        gap: 1.5rem;
        border-left: 1px solid var(--cinza-borda);
        transition: right 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: -10px 0 30px rgba(0, 0, 0, 0.5);
    }

    .nav-links.active {
        right: 0;
    }

    .nav-links a {
        font-size: 1.1rem;
    }

    .hero {
        padding-top: 60px;
        padding-bottom: 60px;
    }

    .section {
        padding: 60px 0;
    }

    .timeline {
        padding-left: 30px;
    }

    .timeline::before {
        left: 6px;
    }

    .timeline-dot {
        left: -28px;
    }

    .hero-stats {
        gap: 1.5rem;
    }

    .stat strong {
        font-size: 1.4rem;
    }

    .contact-form-wrapper {
        padding: 1.5rem;
    }
}

@media (max-width: 420px) {
    .logo-text {
        display: none;
    }
    .hero-buttons {
        flex-direction: column;
    }
    .btn {
        width: 100%;
    }
}
